#!/bin/sh
# ★ Migration, idempotent, runs on every flash (no guard by design): a config-
# preserving sysupgrade from v1.3 or earlier keeps the user's radio0 at VHT80/VHT40,
# and on this unit those widths associate clients but never complete DHCP
# (docs/WIFI-DUAL-BAND.md, 4c358a2). Only HT20 carries data. Bump it; touch nothing
# else. Sorts after 10_ (which may create radio0 via `wifi config`) and before 99_.
# BOARD GATE: DIR-842 R1 (gwr1200ac-v1) only — see the header of
# 09_wireless-dualband-dir842. It edits wireless.radio0, which is not the same
# radio on every board. The "no guard by design" note above was about
# idempotence across sysupgrades, not about running on other hardware; the
# board gate keeps that property for gwr1200ac-v1 and drops the file entirely
# elsewhere.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "gwr1200ac-v1" ] || exit 0

case "$(uci -q get wireless.radio0.htmode)" in
	VHT80|VHT40|HT40)
		uci -q set wireless.radio0.htmode='HT20'
		uci -q commit wireless
		;;
esac
exit 0
