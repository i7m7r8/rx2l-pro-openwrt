#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update
board=$(cat /tmp/sysinfo/board_name)

# R4 audit: the call below used to be unconditional, which silently handed EVERY
# board the DIR-842 R1 datapath. It is per-board now, because for rx2l-pro that
# assumption is boot-defining rather than cosmetic: eth0.2/eth0.1 only carry
# traffic if the RTL819x SoC VLAN table forwards the CPU NIC line (bit 8) to a
# port that reaches the outside world, and rtl819x-eth.c hardcodes that table for
# the reference topology (sw_add_vlan_fid(RTL865X_VID_LAN, 0x10F, ...) = "jacks
# 0-3 + CPU8"). The RX2L Pro's jacks hang off an external RTL8367RB-class switch
# whose CPU trunk is not even identified yet, so naming a VLAN device that
# nothing reaches is exactly how a box boots "alive but unreachable". Each layout
# now sits next to the board it was measured on.
case $board in
  rx2l-pro|*rx2l-pro)
    # The external RTL8367RB is a swconfig switch (`switch0`), and the SoC-side
    # driver does NOT hand us untagged per-jack netdevs: rtl819x_eth.c tags every
    # received frame itself with RTL_NASH_VID=9 (LAN) or RTL_WAN_VID=8 (WAN)
    # (drivers/net/ethernet/rtl819x/rtl819x_eth.c:54-55, the
    # __vlan_hwaccel_put_tag at :679), so the interfaces that can actually see
    # traffic are eth0.9 and eth0.8. An earlier version of this file used
    # "eth0"/"eth0.1" -- the internal-rtl865x shape -- which on this board can
    # only ever receive nothing: eth0.1 carries VID 1 and the driver never emits
    # it.
    #
    # Port roles come from the stock firmware's own config (mtd2 CFG, dumped from
    # this unit), not from a guess:
    #   lanvlan=1 0x15d 0x40     -> VLAN 1 members {0,2,3,4,6,8}, untagged {6}
    #   wanvlan1=2 0x142 0x40    -> VLAN 2 members {1,6,8},     untagged {6}
    #   lan1/2/3.phyid=4/3/2     -> LAN jacks are switch ports 4,3,2
    #   wan1.phyid_default=1     -> WAN jack is switch port 1
    #   bit 6 in both masks      -> the CPU trunk is port 6, untagged on the
    #                               vendor side (6t here, because our driver
    #                               wants tagged frames -- see below)
    # Port 0 is a member of LAN VLAN 1 in the vendor config but no stock netdev
    # or phyid maps to it, so it is left out: an unlabelled port that silently
    # joins the LAN bridge is worse than a port that does nothing.
    #
    # VLAN IDs: ucidef_add_switch cannot express 9/8. config_generate writes
    # `vlan='$role'`, i.e. the ROLE's sequence number (lan=1, wan=2); the
    # per-port index `"4:lan:9"` is parsed into the JSON and never read
    # (package/base-files/files/bin/config_generate:244). So the stanza below
    # produces VLANs 1/2 with devices eth0.1/eth0.2, and
    # etc/uci-defaults/13_switch_vlans_rx2lpro renumbers them to the 9/8 the
    # driver actually tags.
    #
    # That two-step is the platform's own pattern -- its
    # uci-defaults/06_switch_vlan_ids does exactly this for its board, which is
    # why that script exists at all. Ours is board-gated the same way, so the
    # two never fight.
    ucidef_add_switch "switch0" \
        "4:lan" "3:lan" "2:lan" "1:wan" "6t@eth0"
    # LAN/WAN devices come from the switch stanza above (eth0.1/eth0.2) and are
    # renamed by the renumber script; do not pin them here, or the two writes
    # disagree.
    #
    # Failure mode if the switch driver fails to probe: no eth0.9/eth0.8, board
    # reachable only over the 2.4 GHz AP or serial. That is the intended shape
    # -- visibly dead Ethernet, never a silently bridged LAN/WAN.
    ;;
  *)
    # R3: this used to say "eth0" "eth1". There IS no eth1 on the DIR-842 R1 — the
    # SoC has a single CPU-port netdev and Linux splits it into eth0.2 (LAN, VID2)
    # / eth0.1 (WAN, VID1). The phantom eth1 had a real consequence: config_generate
    # emitted a wan_eth1_dev device section and hung the per-unit WAN MAC off a
    # device that never appears, so eth0.1 silently inherited eth0's (LAN) MAC. The
    # ASIC programs its WAN netif from eth0.1's live MAC and rewrites HW-routed
    # egress src to it, so LAN==WAN breaks the LAN=WAN+1 invariant and blackholes
    # CPU<->WAN traffic while HW-routed frames still work. Name real devices.
    ucidef_set_interfaces_lan_wan "eth0.2" "eth0.1"
    ;;
esac

lan_mac=""
wan_mac=""

case $board in
  dir-815-d1)
    offset=$(strings -t x "$(find_mtd_part boot)" | grep llconfig | head -n 1 | awk '{ print "0x"$1 }')
    offset=$((offset+53))
    wan_mac=$(mtd_get_mac_binary boot $offset)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  re708-v1)
    wan_mac=$(mtd_get_mac_binary boot 131079)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  gwr1200ac-v1)
    # DIR-842 R1: the mtd1 "MAC" partition carries TWO overlaid schemas.
    #   0x00: D-Link per-unit base MAC as a 17-byte ASCII string ("e0:1c:fc:51:c9:ee")
    #         = the WAN MAC; LAN = WAN + 1. This is what stock uses (libhwdata.so).
    #   0x13: the Realtek vendor DEFAULT binary macAddr[] block (00:e0:4c:81:96:c1..c8),
    #         identical on every unit.
    # Reading offset 19 (=0x13) gives every board the same MAC, so read the ASCII
    # field and fall back only if it is missing/garbage.
    #
    # ★ THIS IS THE SINGLE SOURCE OF TRUTH FOR THE MAC — do not add a second one.
    # An earlier attempt ALSO pinned network.lan/wan.macaddr from uci-defaults. Two
    # independent sources is what made the MAC non-deterministic: some boots came up
    # on the per-unit MAC and identical later boots on the fallback, depending on
    # which writer won. board.d is the right place because it runs before netifd
    # configures the interfaces, and this read is proven to work here (a boot with
    # this code brought eth0.2 up as e0:1c:fc:51:c9:ef).
    # The driver side follows automatically: gw_netif_mac() programs the ASIC netif
    # from the interface's LIVE MAC, so Linux and the ASIC cannot disagree.
    wan_mac=$(dd if=/dev/mtd1 bs=1 count=17 2>/dev/null)
    case "$wan_mac" in
      [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
      *) wan_mac=$(mtd_get_mac_binary MAC 19) ;;
    esac
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  rx2l-pro|*rx2l-pro)
    # Tenda keeps the per-unit MACs as ASCII key=value lines inside the mtd2
    # "CFG" text config, not in a binary MAC block. Offsets verified on a live
    # dump of this unit (the values themselves are elided: the console root
    # password is derived from the LAN MAC, so never bake one into a repo):
    #   0x22d  TENDA.lan_mac=    -> base/LAN
    #   0x5a5  TENDA.wlan0_mac=  -> 2.4 GHz
    #   0x5c7  TENDA.wlan1_mac=  -> 5 GHz
    # ★ There is no wan_mac line -- the vendor derives it, and we do not know
    # how. WAN = LAN+1 is OUR choice, deliberately one off LAN and clear of
    # B4/C4 used by the radios. It must differ from LAN: the RTL819x ASIC
    # programs its WAN netif from the WAN netdev's live MAC and rewrites
    # HW-routed egress src to it, so LAN==WAN blackholes CPU<->WAN while
    # HW-routed frames still work (see the gwr1200ac-v1 comment above).
    # Single source of truth: board.d only, never also in uci-defaults.
    lan_mac=$(grep -ao 'TENDA\.lan_mac=[0-9A-Fa-f:]\{17\}' "$(find_mtd_part CFG)" |
              head -n1 | cut -d= -f2 | tr 'A-F' 'a-f')
    [ -z "$lan_mac" ] || wan_mac=$(macaddr_add "$lan_mac" 1)
    ;;
  gwr1200ac-v2)
    wan_mac=$(mtd_get_mac_binary boot 131091)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  actionrg1200-v1 | \
  actionrf1200-v1)
    wan_mac=$(mtd_get_mac_ascii boot HW_NIC0_ADDR)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  gwr-300n-v1)
    wan_mac=$(mtd_get_mac_binary boot 24595)
    lan_mac=$(mtd_get_mac_binary boot 24583)
    ;;
  re172-v1)
    wan_mac=$(mtd_get_mac_binary boot 24583)
    lan_mac=$(mtd_get_mac_binary boot 24595)
esac

[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac

board_config_flush

exit 0
