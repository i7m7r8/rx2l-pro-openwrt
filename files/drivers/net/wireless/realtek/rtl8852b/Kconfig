# RTL8852B/PHL WiFi driver configuration

config RTL8852B
	tristate "Realtek RTL8852B/RTL8832BR PHL WiFi driver"
	depends on MAC80211 && PCI
	select FW_LOADER
	select CRC32
	help
	  This driver supports the Realtek RTL8852B and RTL8832BR WiFi chips
	  found on Realtek RTL8197F based routers (e.g., Tenda RX2L Pro).
	  
	  The PHL (PHY Layer) driver implements:
	  - PCIe device probe and initialization
	  - Firmware loading (RTL8852BFW)
	  - PHL/HALMAC framework
	  - MAC/PHY/RF calibration
	  - mac80211 integration
	  
	  If unsure, say M.

config RTL8852B_DEBUG
	bool "Enable RTL8852B debug interface"
	depends on RTL8852B && DEBUG_FS
	help
	  Enable debugfs interface for RTL8852B PHL driver.
