# RTL8832BR 5GHz WiFi driver configuration

config RTL8832BR
	tristate "Realtek RTL8832BR 5GHz WiFi driver"
	depends on MAC80211 && PCI
	select FW_LOADER
	select CRC32
	help
	  This driver supports the Realtek RTL8832BR 5GHz WiFi chip
	  found on Realtek RTL8197F based routers (e.g., Tenda RX2L Pro).
	  
	  The driver implements:
	  - PCIe device probe and initialization
	  - Firmware loading
	  - RF calibration (IQK, TSSI, TXGAPK, PSD)
	  - Power management
	  - mac80211 integration
	  
	  If unsure, say M.

config RTL8832BR_DEBUG
	bool "Enable RTL8832BR debug interface"
	depends on RTL8832BR && DEBUG_FS
	help
	  Enable debugfs interface for RTL8832BR driver.
	  This provides access to calibration data, register dumps,
	  and RF calibration status for debugging.
