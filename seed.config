# Build seed for the Tenda RX2L Pro, on the 6.18 / rtl819x base.
#
# build.sh copies this to .config, then runs `make defconfig`, so this file
# states intent and defconfig fills the rest. It is the port of the 4.14 seed:
# every symbol that moved, died or was renamed is called out where it used to
# be, because a seed line that no longer resolves is dropped SILENTLY at
# defconfig time -- the failure the 4.14 build.sh spells out in capitals ("no
# web UI and no error anywhere"), which is why build.sh.new greps for it after
# defconfig instead of trusting the reader.
#
# Evidence for each claim below is file:line in the tree it names:
#   BASE   = openwrt/openwrt @ 82e2e4f492d58b5b6afaf5b55d8286c58da9c224
#   OVL    = Elengal/openwrt-rx23302 @ 80e62b6 (openwrt/ overlay tree)
#   PKGS   = packages feed @ 712ee13a, LUCI = luci feed @ 4c0a4eda
CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
# ★ Device profile name is track 02/03's to choose; the symbol is the Device/
# name lowercased (OVL openwrt/target/linux/rtl819x/image/rtl8197f.mk:11 defines
# Device/electra_rx23302 and their own diffconfig selects
# CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_electra_rx23302=y,
# rx23302.diffconfig:3). If it is named anything other than tenda_rx2lpro,
# change it HERE and in build.sh's defconfig gate, or no image is built.
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_tenda_rx2lpro=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- switch / datapath -------------------------------------------------------
# Was: kmod-nf-flow + kmod-ipt-offload, with swconfig deliberately absent
# because nothing on the 4.14 base registered a switch agent. On this base the
# RTL8367RB-class board chip IS driven: OVL
# target/linux/rtl819x/rtl8197f/config-6.18:208-231 builds SWCONFIG,
# RTL8366_SMI and RTL8367B_PHY *into* the kernel (=y, not =m), so there is no
# kmod to select -- only the userspace, which is a core package
# (BASE package/kernel/linux/modules/netdevices.mk:1040 defines kmod-swconfig,
# but it is moot here; BASE package/network/config/swconfig/ ships the tool).
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_rtlmib=y
# The 2.4 GHz radio is configured through the vendor's private ioctls; the
# stock path uses `iwpriv`, and there is NO wireless-tools in this feed pin
# (PKGS: no net/wireless-tools in the tree listing at 712ee13a). OVL ships
# package/utils/rtlmib for exactly that job and puts it in the target's
# DEFAULT_PACKAGES (OVL target/linux/rtl819x/Makefile:25), so it is listed here
# for intent, not because defconfig would miss it.
#
# Offload: the hardware NAT in this tree is a *flowtable* backend
# (OVL files-6.18/drivers/net/ethernet/rtl819x_hwnat.c on
# TC_SETUP_FT/FLOW_CLS_*), armed by nftables flowtable, not by the iptables
# xt_FLOWOFFLOAD target. So kmod-ipt-offload is out and kmod-nft-offload is in.
# Both symbols exist in BASE (package/kernel/linux/modules/netfilter.mk:327 for
# ipt-offload, :1381 for nft-offload); the choice is which datapath the driver
# is wired to. kmod-nft-offload is also in BASE's router defaults
# (include/target.mk:52-58), and OVL's uci-defaults
# 05_enable_flow_offloading flips flow_offloading_hw -- the measured
# 857-929 Mbit/s path.
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
# nftables itself is NOT seeded: it comes in through firewall4's dependency on
# the default variant, which is nftables-nojson (BASE
# package/network/utils/nftables/Makefile:46-50). Forcing nftables-json
# (:54) buys a libjson-c dependency this flash size should not pay for.

# ---- WiFi: 5 GHz — still NOT selected, and still a measurement ---------------
# RTL8832BR (Wi-Fi 6) over PCIe, RFE50. Mainline rtw88 cannot bind it, rtw89
# has no 8832 (FACTS.md §6), and neither BASE nor OVL ships anything for it.
# Track 06 owns it. Seeding a wifi-device with no driver is what makes netifd
# fail the whole wireless bring-up, 2.4 GHz included, so it stays out.
#
# ---- WiFi: on-SoC 2.4 GHz WMAC -----------------------------------------------
# Was: CONFIG_PACKAGE_kmod-rtl8192cd=y (from the ADCDS package). That symbol
# does not exist in this base: the HAL is in-tree and built-in --
# OVL target/linux/rtl819x/rtl8197f/config-6.18:238-246 (WLAN_HAL,
# WLAN_HAL_88XX, WLAN_HAL_8197F, RTL8192FE_RX23302, WIRELESS_EXT/WEXT_PRIV).
# BASE itself has no rtl8192cd anywhere (git ls-tree of 82e2e4f4 finds 0 hits),
# so there is no kmod line to write. If track 05 packages it as =m instead,
# add the kmod here -- and note the comment in OVL's config-6.18:233-237: as an
# embedded (=y) build a driver that hangs in rtl8192cd_init_one takes the whole
# boot with it, which is why their first-boot goal was wired-only.
# No wpad / iw / kmod-mac80211 on purpose: the glue is a netifd script handler
# (OVL base-files/lib/netifd/wireless/rtl8192cd.sh) with in-driver WPA2-PSK, not
# nl80211 hostapd. Revisit only if 05 lands an nl80211 path.
#
# RF calibration comes from the vendor's CFG/CFM blocks; if 05 reads it as an
# nvmem cell, CONFIG_NVMEM is already =y in this target (OVL
# target/linux/rtl819x/config-6.18:1) and BASE leaves it off
# (target/linux/generic/config-6.18:4701), so nothing more is needed here.

# ---- LED / button -----------------------------------------------------------
# Both are core packages and unchanged: BASE
# package/kernel/linux/modules/leds.mk:10 (kmod-leds-gpio) and
# package/kernel/gpio-button-hotplug/Makefile:11 (kmod-gpio-button-hotplug).
# The pins themselves are NOT declared yet (FACTS §5, README risk #9): an LED
# node on the wrong GPIO line held the external switch in reset on the
# reference board, so track 03 decides, not the seed.
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# ---- WAN + diagnostics -------------------------------------------------------
# Unchanged as symbols, but note ppp moved: it is a CORE package now (BASE
# package/network/services/ppp/Makefile), not a feed package, and it is already
# in BASE's router defaults (include/target.mk:59-60) together with
# odhcp6c/odhcpd-ipv6only (lines 57-58) -- listed here for intent only.
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y

# ---- web UI ------------------------------------------------------------------
# LuCI here is the ucode stack, which is what the 19.07 pins existed to avoid.
# It builds against this base: OVL's own release config selects the same set
# (OVL rx23302.diffconfig:11-38). The three names that MOVED:
#   luci-app-opkg        -> luci-app-package-manager  (LUCI: no
#                          applications/luci-app-opkg at 4c0a4eda;
#                          applications/luci-app-package-manager exists)
#   qos-scripts         -> DROPPED. It still exists in BASE
#                          (package/network/config/qos-scripts/Makefile:24
#                          depends on +iptables +tc), but it programs iptables
#                          while firewall4 owns the packet filter now: selecting
#                          it buys a broken QoS and ~1 MB. Use qosify (BASE
#                          package/network/config/qosify) or sqm-scripts (PKGS
#                          net/sqm-scripts/Makefile) if QoS is wanted; neither
#                          is seeded because on a 857-929 Mbit/s flowtable
#                          datapath classful qdisc on the LAN interface is the
#                          thing that costs the throughput back.
#   miniupnpd           -> real symbol via PROVIDES (PKGS
#                          net/miniupnpd/Makefile:35) but the concrete package
#                          is miniupnpd-nftables (same file:54-60,
#                          DEFAULT_VARIANT:=1). Spelling it out because the
#                          iptables variant is CONFLICTS, not co-installable.
#   cgi-io              -> DROPPED. It DOES still exist in this feed pin (PKGS
#                          net/cgi-io/Makefile:26), contrary to the note in the
#                          4.14 feeds.conf; it is just no longer what LuCI's
#                          upload path uses (rpcd-mod-file is). Not needed.
# ★ Select `luci` by NAME (the collection, LUCI collections/luci) -- see the
#   defconfig gate in build.sh: if that symbol vanishes, uhttpd and the admin
#   pages go with it, silently.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# ---- IPv6 --------------------------------------------------------------------
# Symbols unchanged (BASE package/network/services/odhcpd/Makefile:53 keeps
# the -ipv6only variant; package/network/ipv6/odhcp6c/Makefile exists) and both
# are in BASE's router defaults already.
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# ---- crashlog: the knob is GONE, and so was the bug --------------------------
# The 4.14 seed had "# CONFIG_KERNEL_CRASHLOG is not set" because OpenWrt's
# crashlog handler recursed inside die() on this SoC and masked the real first
# oops. There is no crashlog to switch off on this base: BASE
# target/linux/generic/config-6.18 has no CONFIG_CRASHLOG line and
# target/linux/generic/hack-6.18/ carries no crashlog patch (only the
# 650-netfilter-add-xt_FLOWOFFLOAD-target.patch in the netfilter range) -- the
# feature was dropped with the 4.14/5.10 hacks. Leaving the line in would be a
# dead symbol; leaving it OUT costs nothing.
# Related, and now handled by the base rather than by us: pstore/ramoops is off
# upstream at target/linux/generic/config-6.18:5155-5162 (# CONFIG_PSTORE is not
# set), which is what the DIR-842 TX-wedge note in the 4.14 config wanted. Do
# not re-enable it (README risk #10) -- and if anyone does, it needs
# CONFIG_PSTORE_RAM plus a /reserved-memory node in track 03's DTS, not a seed
# line only.

# ---- small flash -------------------------------------------------------------
# OVL target/linux/rtl819x/rtl8197f/target.mk:9 adds FEATURES+=small_flash, so
# LZR/size trimming is target-side. Nothing here should pull a big package set
# "for completeness": keep this file minimal and let the device profile's
# DEVICE_PACKAGES carry board-specific extras (BASE include/image.mk collects
# them at build time either way).
