#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# RX2L Pro, part 2 of 2: the hardware-NAT gates, driven by the same LuCI
# tickbox as rtl819x-hwnat.
#
# Ported from base A /etc/init.d/rtl819x-hwnat-gate.
#
# START=95, i.e. AFTER network (20), and that ordering is the entire point:
# router mode writes PVID/VLAN/MACCR1 into the switch, and the eth driver
# rewrites those in rtl819x_intsw_nastroit() at ifup. Turning router mode on
# before ifup produced a broken L2 on base A's bench (their comment: dated
# 2026-10-29, "сеть пропадала"). The 4.14 line reached the same conclusion
# from the other side -- README risk #11, dir842-asic's S97 bring-up arming
# hwnat with D-Link flash geometry, including a 17-byte read of /dev/mtd1
# which on this board is the vendor Bootloader.
#
# hw=1: router mode ON, hwnat gate ON, ASIC frame opened (cat /proc/rtl865x_gw).
# hw=0: both gates OFF, switch stays in plain mode, software path only.
#
# ⚠ THE NODE NAMES BELOW ARE base A's, NOT measured on this board. Verify
# every one on the first RAM boot before trusting the service (they are
# guarded with [ -w ], so a wrong name is a silent no-op, not a crash --
# but a silent no-op is exactly what "hardware NAT never engaged" looks like):
#   ls -l /sys/module/rtl819x/parameters/hwnat /proc/rtl819x_router /proc/rtl865x_gw
#   dmesg | grep 'rtl819x: router mode'
# If base A renamed them (rtl819x_hwnat.c exports), fix them HERE, once.

START=95
USE_PROCD=1

. /lib/realtek.sh

log() { logger -t rtl819x-hwnat-gate "$@"; }

# Router or dumb AP? In AP role there is no separate WAN: it is removed,
# disabled, or WAN *is* br-lan. Hardware NAT is not applicable (no routing,
# traffic is L2) and router mode would rebuild the switch and could cut the
# WAN jack out of the bridge -- base A saw exactly that (VLAN 8 swallowing the
# WAN port). So: do not arm in AP mode.
is_router() {
	local dev
	[ "$(uci -q get network.wan)" ] || return 1
	[ "$(uci -q get network.wan.disabled)" = "1" ] && return 1
	dev=$(uci -q get network.wan.device)
	[ -n "$dev" ] || return 1
	[ "$dev" = "br-lan" ] && return 1
	return 0
}

hw_wanted() {
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]
}

gates_off() {
	[ -w /sys/module/rtl819x/parameters/hwnat ] &&
		echo 0 > /sys/module/rtl819x/parameters/hwnat
	[ -w /proc/rtl819x_router ] && echo 0 > /proc/rtl819x_router
}

apply() {
	rx2lpro_is_board || return 0

	if hw_wanted && ! is_router; then
		gates_off
		log "AP mode (no separate WAN): hardware NAT not applicable, gates off"
	elif hw_wanted; then
		[ -w /proc/rtl819x_router ] && echo 1 > /proc/rtl819x_router
		[ -w /sys/module/rtl819x/parameters/hwnat ] &&
			echo 1 > /sys/module/rtl819x/parameters/hwnat
		# Reading the node is the trigger: it makes the driver program the
		# ASIC frame (base A's `cat /proc/rtl865x_gw >/dev/null`).
		cat /proc/rtl865x_gw >/dev/null 2>&1
		log "hardware NAT ON (router mode + hwnat gate)"
	else
		gates_off
		log "hardware NAT OFF (software path)"
	fi
}

start_service() { apply; }
stop_service() { gates_off; }

# Toggling the tickbox on a LIVE box is not stable on this SoC family: base A
# measured one live enable that dropped RX (VLAN 9 without port 0 / CPU tag)
# and wedged the unit hard enough to need a power cycle -- a big frame was
# enough. So a mode CHANGE is applied by rebooting: the snippet is already
# prepared by START=17 and the gates come up with this service on boot.
# This is a deliberate reboot, and it only fires when the effective mode
# actually differs, so editing an unrelated firewall rule never reboots.
reload_service() {
	local want=0 cur=0

	rx2lpro_is_board || return 0
	hw_wanted && is_router && want=1
	[ "$(head -1 /proc/rtl819x_router 2>/dev/null)" = "1" ] && cur=1

	[ "$want" = "$cur" ] && return 0

	logger -t rtl819x-hwnat-gate \
		"NAT mode change ($cur -> $want): rebooting, live gate switching is unstable"
	reboot
}

service_triggers() {
	procd_add_reload_trigger firewall
}
