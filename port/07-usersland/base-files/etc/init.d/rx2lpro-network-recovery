#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# RX2L Pro: bring the box back to a reachable state if first-boot network
# configuration did not produce a live LAN.
#
# PROVENANCE: pattern taken from the iptime A2004MU port's
#   target/linux/rtl819x/base-files/etc/init.d/a2004mu-network-recovery
# in /tmp/rebase/iptime-a2004mu-openwrt/patches/openwrt/
#   0001-iptime-a2004mu-rtl8197f-support.patch:293-311 (GPL-2.0), extended
# with the wireless fallback because on THIS board the wired path is the part
# we have never measured (README risk #6: the external RTL8367 has no DT node
# and no driver landed yet in any tree we hold).
#
# WHY IT IS NEEDED HERE SPECIFICALLY
# ---------------------------------------------------------------------------
# Two failure modes on this device are "boots fine, cannot get in":
#   1. 02_network picked a device that does not exist. On the 4.14 base an
#      unmatched board name meant *no* configuration at all; on the new base
#      it means br-lan over ports that are not there, which looks identical
#      from the outside -- no DHCP, no LuCI, silent.
#   2. netifd's bring-up aborts on a missing dependency (a radio with no
#      driver, a switch_vlan referencing an absent switch0) and leaves every
#      interface down.
# Neither writes a log line you would find by accident, and both survive a
# power cycle. This service makes the difference visible and recoverable from
# the LAN cable alone.
#
# boot() only -- never start(). It must run exactly once, early, and it must
# NOT fight the user afterwards. START=96: after network (20) and after
# rtl819x-hwnat-gate (95), before the late diagnostics.

START=96

boot() {
	. /lib/functions.sh
	. /lib/realtek.sh

	rx2lpro_is_board || return 0

	# Give netifd a bounded window to bring LAN up. `ubus -t 20 wait_for`
	# is the iptime idiom: it blocks up to 20 s and returns non-zero if the
	# object never appears, so this costs nothing on a healthy boot.
	ubus -t 20 wait_for network.interface.lan >/dev/null 2>&1 && return 0

	logger -t rx2lpro-network-recovery \
		"network.interface.lan absent after 20 s -- wired path is down, applying fallback"

	# Fallback 1: whatever the switch turned out to be, eth0 is the SoC CPU
	# netdev (rtl819x_eth.c registers exactly one). Point lan at it and take
	# the address away from any half-configured VLAN device.
	uci -q set network.lan.device='eth0'
	uci -q set network.lan.proto='static'
	uci -q set network.lan.ipaddr='192.168.1.1'
	uci -q set network.lan.netmask='255.255.255.0'
	# A LAN-side DHCP server is what actually gets a laptop onto the box.
	uci -q enable dhcp.lan
	uci -q commit network
	/etc/init.d/network restart

	# Fallback 2: make sure the 2.4 GHz AP really is up, since it is the
	# second way in and the only one that needs no cable. Do not create
	# configuration here -- if the radio stanza is missing, the seed never
	# ran, and re-running uci-defaults is the honest fix.
	[ -e /etc/config/wireless ] && wifi config >/dev/null 2>&1
	uci -q get wireless.radio0 >/dev/null ||
		logger -t rx2lpro-network-recovery \
			"no wifi-device in /etc/config/wireless: /lib/wifi/rtl8192cd.sh did not run or the driver is absent -- no wireless fallback available"
	uci -q set wireless.radio0.disabled='0'
	uci -q commit wireless
	wifi reload 2>/dev/null || wifi

	logger -t rx2lpro-network-recovery \
		"fallback applied: LAN=eth0 192.168.1.1 + 2.4 GHz AP. Fix the real topology with 'uci set network.lan.device=...'"
}
